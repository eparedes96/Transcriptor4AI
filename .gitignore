# ==============================================================================
# TRANSCRIPTOR4AI .GITIGNORE (Clean Repository Protocol)
# ==============================================================================

# --- Python Standard ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Distribution / Build ---
build/
dist/
*.spec
*.egg-info/
.eggs/

# --- IDEs / Editors ---
.idea/
*.iml
.vscode/

# --- Environments & Logs ---
.env
.venv
env/
venv/
*.log

# --- Infrastructure Cache & Local State ---
config.json
pricing_cache.json
cache.db
cache.db-journal
cache.db-wal

# --- Transcription Artifacts ---
*_tests.txt
*_modules.txt
*_resources.txt
*_tree.txt
*_errors.txt
*_full_context.txt
transcript/

# --- Internal Dev Tools & Private Test Suites ---
tools/dev/
tests/unit/tools/dev/

# --- OS Specific ---
.DS_Store
Thumbs.db